# Required: Google Sheets spreadsheet ID to read the latest row from.
SPREADSHEET_ID=your-spreadsheet-id-here

# Required: API Gateway endpoint that proxies DynamoDB PutItem.
API_GATEWAY_SUBMIT_URL=https://example.execute-api.us-east-1.amazonaws.com/prod/submit

# Required: API Gateway endpoint that proxies DynamoDB list/scan.
API_GATEWAY_LIST_URL=https://example.execute-api.us-east-1.amazonaws.com/prod/submit/list

# Required: Path to a GCP service-account key file with Sheets read access.
# In Cloud Run this is mounted from Secret Manager. Locally use a gitignored file.
GOOGLE_APPLICATION_CREDENTIALS=./local-sa-key.json

# Optional: HTTP port the server binds to. Defaults to 8080.
PORT=8080

# Optional: A1 range read for the latest row. Defaults to A2:E2.
SHEET_RANGE=A2:E2

# Optional: Per-request timeout in ms for outbound fetch. Defaults to 10000.
FETCH_TIMEOUT_MS=10000

# Optional: Retry attempts for transient API Gateway failures. Defaults to 3.
FETCH_MAX_RETRIES=3
